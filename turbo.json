{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "storybook-static/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "a11y": {
      "dependsOn": [
        "build"
      ]
    },
    "visual": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "size": {
      "dependsOn": [
        "build"
      ]
    },
    "check:contrast": {
      "dependsOn": [
        "^build"
      ]
    },
    "check:slots": {
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.types.ts",
        "../../tools/check-slots.mjs"
      ]
    },
    "gen:palette": {
      "cache": false
    },
    "gen:docs": {
      "dependsOn": [
        "@stellaria/nebula-web#build"
      ],
      "cache": false
    },
    "check:docs": {
      "dependsOn": [
        "@stellaria/nebula-web#build"
      ],
      "inputs": [
        "src/**",
        "$TURBO_ROOT$/packages/web/src/**",
        "$TURBO_ROOT$/packages/web/dist/**",
        "$TURBO_ROOT$/packages/web/.size-limit.js",
        "$TURBO_ROOT$/docs/00-inventory.md",
        "$TURBO_ROOT$/apps/docs/generated/**"
      ]
    }
  }
}
