{
  "name": "playground-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "a11y": "concurrently -k -s first -n SB,A11Y \"http-server storybook-static -p 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006\""
  },
  "devDependencies": {
    "@stellaria/nebula-hooks": "workspace:*",
    "@stellaria/nebula-icons": "workspace:*",
    "@stellaria/nebula-themes": "workspace:*",
    "@stellaria/nebula-tokens": "workspace:*",
    "@stellaria/nebula-web": "workspace:*",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@storybook/test-runner": "^0.24.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/vite-plugin": "^5.2.5",
    "axe-playwright": "^2.2.2",
    "concurrently": "^10.0.3",
    "form-atoms": "^3.3.3",
    "http-server": "^14.1.1",
    "jotai": "^2.20.2",
    "lucide-react": "^0.469.0",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.2",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "wait-on": "^9.0.10",
    "zod": "4.4.3"
  }
}
