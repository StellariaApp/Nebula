{
  "name": "nebula-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "size": "turbo run size",
    "visual": "turbo run visual",
    "check:contrast": "turbo run check:contrast",
    "check:slots": "turbo run check:slots",
    "gen:docs": "turbo run gen:docs",
    "check:docs": "turbo run check:docs",
    "gen:palette": "turbo run gen:palette --",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prettier": "3.9.5",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  }
}
