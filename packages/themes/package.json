{
  "name": "@stellaria/nebula-themes",
  "version": "0.0.0",
  "description": "Temas oficiales, Zod schema del theme y presets del design system Nebula",
  "license": "MIT",
  "author": "Stellaria",
  "homepage": "https://nebula.stellaria.app/guides/getting-started/installation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StellariaApp/Nebula.git",
    "directory": "packages/themes"
  },
  "bugs": "https://github.com/StellariaApp/Nebula/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellaria/nebula-tokens": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
