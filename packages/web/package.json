{
  "name": "@stellaria/nebula-web",
  "version": "0.0.0",
  "private": true,
  "description": "Componentes web del design system Nebula (Vanilla Extract + React Aria + motion)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "NebulaProvider (runtime + CSS de temas)",
      "path": "dist/index.js",
      "import": "{ NebulaProvider }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "15 kB"
    },
    {
      "name": "useTheme (sin CSS)",
      "path": "dist/index.js",
      "import": "{ useTheme }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "9 kB"
    },
    {
      "name": "Box (primitivo, por módulo)",
      "path": "dist/components/Box/Box.js",
      "import": "{ Box }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "9 kB"
    },
    {
      "name": "Text (primitivo, por módulo)",
      "path": "dist/components/Text/Text.js",
      "import": "{ Text }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "9 kB"
    },
    {
      "name": "Button (compuesto: Aria + motion, por módulo)",
      "path": "dist/components/Button/Button.js",
      "import": "{ Button }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "48 kB"
    },
    {
      "name": "Flex (primitivo, por módulo)",
      "path": "dist/components/Flex/Flex.js",
      "import": "{ Flex }",
      "ignore": ["react", "react-dom"],
      "limit": "9 kB"
    },
    {
      "name": "Center (primitivo, por módulo)",
      "path": "dist/components/Center/Center.js",
      "import": "{ Center }",
      "ignore": ["react", "react-dom"],
      "limit": "9 kB"
    },
    {
      "name": "Group (primitivo temable en runtime, por módulo)",
      "path": "dist/components/Group/Group.js",
      "import": "{ Group }",
      "ignore": ["react", "react-dom"],
      "limit": "12 kB"
    },
    {
      "name": "Grid (compuesto, por módulo)",
      "path": "dist/components/Grid/Grid.js",
      "import": "{ Grid }",
      "ignore": ["react", "react-dom"],
      "limit": "12 kB"
    },
    {
      "name": "GridCol (primitivo temable en runtime, por módulo)",
      "path": "dist/components/Grid/Col.js",
      "import": "{ GridCol }",
      "ignore": ["react", "react-dom"],
      "limit": "12 kB"
    },
    {
      "name": "SimpleGrid (primitivo temable en runtime, por módulo)",
      "path": "dist/components/SimpleGrid/SimpleGrid.js",
      "import": "{ SimpleGrid }",
      "ignore": ["react", "react-dom"],
      "limit": "12 kB"
    },
    {
      "name": "Container (primitivo temable en runtime, por módulo)",
      "path": "dist/components/Container/Container.js",
      "import": "{ Container }",
      "ignore": ["react", "react-dom"],
      "limit": "12 kB"
    },
    {
      "name": "Scroll (primitivo temable en runtime, por módulo)",
      "path": "dist/components/Scroll/Scroll.js",
      "import": "{ Scroll }",
      "ignore": ["react", "react-dom"],
      "limit": "12 kB"
    },
    {
      "name": "Divider (primitivo temable en runtime, por módulo)",
      "path": "dist/components/Divider/Divider.js",
      "import": "{ Divider }",
      "ignore": ["react", "react-dom"],
      "limit": "12 kB"
    },
    {
      "name": "Space (primitivo temable en runtime, por módulo)",
      "path": "dist/components/Space/Space.js",
      "import": "{ Space }",
      "ignore": ["react", "react-dom"],
      "limit": "12 kB"
    },
    {
      "name": "AspectRatio (primitivo temable en runtime, por módulo)",
      "path": "dist/components/AspectRatio/AspectRatio.js",
      "import": "{ AspectRatio }",
      "ignore": ["react", "react-dom"],
      "limit": "12 kB"
    },
    {
      "name": "Paper (primitivo temable en runtime, por módulo)",
      "path": "dist/components/Paper/Paper.js",
      "import": "{ Paper }",
      "ignore": ["react", "react-dom"],
      "limit": "12 kB"
    },
    {
      "name": "VisuallyHidden (primitivo, por módulo)",
      "path": "dist/components/VisuallyHidden/VisuallyHidden.js",
      "import": "{ VisuallyHidden }",
      "ignore": ["react", "react-dom"],
      "limit": "9 kB"
    },
    {
      "name": "Portal (utilidad, por módulo)",
      "path": "dist/components/Portal/Portal.js",
      "import": "{ Portal }",
      "ignore": ["react", "react-dom"],
      "limit": "6 kB"
    },
    {
      "name": "FocusTrap (utilidad: Aria FocusScope, por módulo)",
      "path": "dist/components/FocusTrap/FocusTrap.js",
      "import": "{ FocusTrap }",
      "ignore": ["react", "react-dom"],
      "limit": "16 kB"
    },
    {
      "name": "Transition (compuesto: motion, por módulo)",
      "path": "dist/components/Transition/Transition.js",
      "import": "{ Transition }",
      "ignore": ["react", "react-dom"],
      "limit": "48 kB"
    },
    {
      "name": "Collapse (compuesto: motion, por módulo)",
      "path": "dist/components/Collapse/Collapse.js",
      "import": "{ Collapse }",
      "ignore": ["react", "react-dom"],
      "limit": "48 kB"
    },
    {
      "name": "Conditional (lógica pura, por módulo)",
      "path": "dist/components/Conditional/Conditional.js",
      "import": "{ Conditional }",
      "ignore": ["react", "react-dom"],
      "limit": "2 kB"
    },
    {
      "name": "Valid (lógica pura, por módulo)",
      "path": "dist/components/Valid/Valid.js",
      "import": "{ Valid }",
      "ignore": ["react", "react-dom"],
      "limit": "2 kB"
    },
    {
      "name": "Omit (lógica pura, por módulo)",
      "path": "dist/components/Omit/Omit.js",
      "import": "{ Omit }",
      "ignore": ["react", "react-dom"],
      "limit": "2 kB"
    }
  ],
  "dependencies": {
    "@stellaria/nebula-hooks": "workspace:*",
    "@stellaria/nebula-icons": "workspace:*",
    "@stellaria/nebula-themes": "workspace:*",
    "@stellaria/nebula-tokens": "workspace:*",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.7.0",
    "motion": "^12.42.2",
    "react-aria": "^3.50.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.21.1",
    "@vanilla-extract/vite-plugin": "^5.2.5",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "size-limit": "^12.1.0",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
