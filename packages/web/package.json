{
  "name": "@stellaria/nebula-web",
  "version": "1.1.11",
  "description": "Componentes web del design system Nebula (Vanilla Extract + React Aria + motion)",
  "license": "MIT",
  "author": "Stellaria",
  "homepage": "https://nebula.stellaria.app/guides/getting-started/installation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StellariaApp/Nebula.git",
    "directory": "packages/web"
  },
  "bugs": "https://github.com/StellariaApp/Nebula/issues",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.css.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./styles.css.d.ts",
      "default": "./styles.css"
    },
    "./command": {
      "types": "./dist/command/index.d.ts",
      "default": "./dist/command/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "default": "./dist/charts/index.js"
    },
    "./datagrid": {
      "types": "./dist/datagrid/index.d.ts",
      "default": "./dist/datagrid/index.js"
    },
    "./dnd": {
      "types": "./dist/dnd/index.d.ts",
      "default": "./dist/dnd/index.js"
    },
    "./carousel": {
      "types": "./dist/carousel/index.d.ts",
      "default": "./dist/carousel/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "default": "./dist/media/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "styles.css",
    "styles.css.d.ts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch --no-emptyOutDir",
    "dev:types": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "size-limit",
    "check:slots": "node ../../tools/check-slots.mjs src"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@internationalized/date": "^3.12.2",
    "@stellaria/nebula-hooks": "workspace:*",
    "@stellaria/nebula-icons": "workspace:*",
    "@stellaria/nebula-themes": "workspace:*",
    "@stellaria/nebula-tokens": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.7.0",
    "embla-carousel-react": "^8.6.0",
    "jotai": "^2.20.2",
    "motion": "^12.42.2",
    "react-aria": "^3.50.0",
    "react-player": "^3.4.0",
    "react-stately": "^3.48.0",
    "recharts": "^3.10.1"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "form-atoms": ">=3.0.0",
    "@pqina/react-pintura": ">=9.0.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.21.1",
    "@vanilla-extract/vite-plugin": "^5.2.5",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "size-limit": "^12.1.0",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "4.1.10"
  },
  "peerDependenciesMeta": {
    "form-atoms": {
      "optional": true
    },
    "@pqina/react-pintura": {
      "optional": true
    }
  }
}
