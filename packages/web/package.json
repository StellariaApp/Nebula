{
  "name": "@stellaria/nebula-web",
  "version": "0.0.0",
  "private": true,
  "description": "Componentes web del design system Nebula (Vanilla Extract + React Aria + motion)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "NebulaProvider (runtime + CSS de temas)",
      "path": "dist/index.js",
      "import": "{ NebulaProvider }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "15 kB"
    },
    {
      "name": "useTheme (sin CSS)",
      "path": "dist/index.js",
      "import": "{ useTheme }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "9 kB"
    },
    {
      "name": "Box (primitivo, por módulo)",
      "path": "dist/components/Layout/Box/Box.js",
      "import": "{ Box }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "9 kB"
    },
    {
      "name": "Text (primitivo, por módulo)",
      "path": "dist/components/Typography/Text/Text.js",
      "import": "{ Text }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "9 kB"
    },
    {
      "name": "Button (compuesto: Aria + motion, por módulo)",
      "path": "dist/components/Actions/Button/Button.js",
      "import": "{ Button }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "48 kB"
    }
  ],
  "dependencies": {
    "@stellaria/nebula-hooks": "workspace:*",
    "@stellaria/nebula-icons": "workspace:*",
    "@stellaria/nebula-themes": "workspace:*",
    "@stellaria/nebula-tokens": "workspace:*",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.7.0",
    "motion": "^12.42.2",
    "react-aria": "^3.50.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.21.1",
    "@vanilla-extract/vite-plugin": "^5.2.5",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "size-limit": "^12.1.0",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
