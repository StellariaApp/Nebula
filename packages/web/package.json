{
  "name": "@stellaria/nebula-web",
  "version": "0.0.0",
  "private": true,
  "description": "Componentes web del design system Nebula (Vanilla Extract + React Aria + motion)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "NebulaProvider (runtime + CSS de temas)",
      "path": "dist/index.js",
      "import": "{ NebulaProvider }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "20 kB"
    },
